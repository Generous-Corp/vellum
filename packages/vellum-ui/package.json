{
  "name": "@vellum/ui",
  "version": "0.1.0-experimental.0",
  "description": "Dependency-free TypeScript and JSX authoring runtime for Vellum applications",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "import": "./src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime.d.ts",
      "import": "./src/jsx-runtime.js"
    }
  },
  "files": [
    "LICENSE.md",
    "README.md",
    "scripts",
    "src"
  ],
  "scripts": {
    "build:native-test": "node scripts/build-native-test.mjs",
    "test:types": "tsc --project test/types/tsconfig.json --noEmit",
    "test": "node --test test/*.test.js && npm run test:types",
    "check": "npm test"
  },
  "dependencies": {
    "esbuild": "0.28.1"
  },
  "bundleDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
