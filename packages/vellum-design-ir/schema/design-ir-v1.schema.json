{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellum.dev/schemas/design-ir/v1",
  "title": "Vellum DesignIR v1",
  "description": "Audio-free canonical retained-scene interchange generated from one immutable design source snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "compiler",
    "source",
    "root",
    "tokens",
    "assets",
    "diagnostics",
    "lossReport"
  ],
  "properties": {
    "$schema": { "const": "https://vellum.dev/schemas/design-ir/v1" },
    "schemaVersion": { "const": 1 },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@vellum/design-ir" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": { "$ref": "#/$defs/source" },
    "root": { "$ref": "#/$defs/node" },
    "tokens": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/token" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "lossReport": { "$ref": "#/$defs/lossReport" }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "namespace", "adapter", "adapterVersion", "formatVersion", "revision"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "formatVersion": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "snapshotHash": { "type": "string" },
        "sourceUri": { "type": "string" },
        "providerFileKey": { "type": "string" },
        "providerNodeId": { "type": "string" },
        "provenance": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["provider", "semantic", "structural"] },
        "sourceId": { "type": "string" },
        "semanticId": { "type": "string" },
        "fingerprint": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "kind", "properties", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "identity": { "$ref": "#/$defs/identity" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "extensions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "tracks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/animationTrack" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "animationTrack": {
      "description": "A keyframed animation of one property of its node, evaluated at the host clock the caller passes. Keyframe times are seconds and strictly increase. Colour properties take #rrggbb or #rrggbbaa values; the others take numbers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "keyframes"],
      "properties": {
        "property": {
          "enum": ["opacity", "translateX", "translateY", "scaleX", "scaleY", "rotation", "fill", "strokeColor", "shadowColor", "gradientStopColor", "textRunColor"]
        },
        "index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "stop": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "keyframes": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/keyframe" } }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "value"],
      "properties": {
        "time": { "type": "number" },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" }
          ]
        },
        "easing": { "$ref": "#/$defs/easing" }
      }
    },
    "easing": {
      "oneOf": [
        { "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x1", "y1", "x2", "y2"],
          "properties": {
            "type": { "const": "cubicBezier" },
            "x1": { "type": "number", "minimum": 0, "maximum": 1 },
            "y1": { "type": "number" },
            "x2": { "type": "number", "minimum": 0, "maximum": 1 },
            "y2": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "steps"],
          "properties": {
            "type": { "const": "steps" },
            "steps": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "position": { "enum": ["start", "end", "none", "both"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "spring" },
            "stiffness": { "type": "number", "exclusiveMinimum": 0 },
            "damping": { "type": "number", "exclusiveMinimum": 0 },
            "mass": { "type": "number", "exclusiveMinimum": 0 },
            "velocity": { "type": "number" }
          }
        }
      ]
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$type", "$value", "sourcePath"],
      "properties": {
        "$type": { "type": "string", "minLength": 1 },
        "$value": { "$ref": "#/$defs/jsonValue" },
        "$description": { "type": "string" },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string" },
        "mimeType": { "type": "string" },
        "uri": { "type": "string" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "provenance": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "disposition", "message", "path", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["portable", "lowered", "rasterized", "web-only", "extension", "unsupported"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "property": { "type": "string" },
        "remediation": { "$ref": "#/$defs/jsonValue" },
        "sourceLocation": { "$ref": "#/$defs/jsonValue" },
        "detail": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "lossReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byDisposition", "bySeverity", "lossCount", "losses", "totalDiagnostics"],
      "properties": {
        "byDisposition": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "bySeverity": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "lossCount": { "type": "integer", "minimum": 0 },
        "losses": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "totalDiagnostics": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
