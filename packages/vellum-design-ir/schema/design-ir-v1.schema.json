{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellum.dev/schemas/design-ir/v1",
  "title": "Vellum DesignIR v1",
  "description": "Audio-free canonical retained-scene interchange generated from one immutable design source snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "compiler",
    "source",
    "root",
    "tokens",
    "assets",
    "diagnostics",
    "lossReport"
  ],
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "enum": [1, 2, 3] } } },
      "then": { "properties": { "root": { "$ref": "#/$defs/nodeWithoutTracks" } } }
    },
    {
      "description": "A version 1 document carries no compositing object on any node; compositing is version 2 vocabulary.",
      "if": { "required": ["schemaVersion"], "properties": { "schemaVersion": { "const": 1 } } },
      "then": { "properties": { "root": { "$ref": "#/$defs/nodeWithoutCompositing" } } }
    },
    {
      "description": "A document before version 3 carries no material reference on any node; materials are version 3 vocabulary.",
      "if": { "required": ["schemaVersion"], "properties": { "schemaVersion": { "enum": [1, 2] } } },
      "then": { "properties": { "root": { "$ref": "#/$defs/nodeWithoutMaterial" } } }
    },
    {
      "description": "A document below version 5 carries no plot binding on any node; plots are version 5 vocabulary.",
      "if": { "required": ["schemaVersion"], "properties": { "schemaVersion": { "enum": [1, 2, 3, 4] } } },
      "then": { "properties": { "root": { "$ref": "#/$defs/nodeWithoutPlot" } } }
    },
    {
      "description": "A document before version 6 carries no vector asset field on any node.",
      "if": { "required": ["schemaVersion"], "properties": { "schemaVersion": { "enum": [1, 2, 3, 4, 5] } } },
      "then": { "properties": { "root": { "$ref": "#/$defs/nodeBeforeVectorAssets" } } }
    }
  ],
  "properties": {
    "$schema": { "const": "https://vellum.dev/schemas/design-ir/v1" },
    "schemaVersion": {
      "enum": [1, 2, 3, 4, 5, 6],
      "description": "The oldest version carrying every field the document uses; each version keeps every field of the ones before it. Version 2 adds the node compositing object, version 3 node material references, version 4 animation tracks, version 5 plot bindings and version 6 the vector asset fields. A field is illegal below the version that introduced it."
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@vellum/design-ir" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "source": { "$ref": "#/$defs/source" },
    "root": { "$ref": "#/$defs/node" },
    "tokens": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/token" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "lossReport": { "$ref": "#/$defs/lossReport" }
  },
  "$defs": {
    "nodeBeforeVectorAssets": {
      "description": "A node, and every node beneath it, without the vector asset fields DesignIR version 6 adds. Path nodes and geometry are part of the earlier contract.",
      "properties": {
        "kind": { "not": { "const": "vector" } },
        "properties": {
          "properties": {
            "vector": false,
            "image": { "properties": { "source": false } },
            "paint": { "properties": { "transform": false, "clipPath": false, "overflow": false } }
          }
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/nodeBeforeVectorAssets" } }
      }
    },
    "jsonValue": {
      "oneOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "namespace", "adapter", "adapterVersion", "formatVersion", "revision"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": "string", "minLength": 1 },
        "formatVersion": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "snapshotHash": { "type": "string" },
        "sourceUri": { "type": "string" },
        "providerFileKey": { "type": "string" },
        "providerNodeId": { "type": "string" },
        "provenance": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["provider", "semantic", "structural"] },
        "sourceId": { "type": "string" },
        "semanticId": { "type": "string" },
        "fingerprint": { "type": "string" },
        "ordinal": { "type": "integer", "minimum": 0 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "kind", "properties", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "identity": { "$ref": "#/$defs/identity" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "text": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "extensions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "tracks": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/animationTrack" } },
        "material": { "$ref": "#/$defs/materialReference" },
        "compositing": { "$ref": "#/$defs/compositing" },
        "plot": { "$ref": "#/$defs/plotBinding" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "nodeWithoutTracks": {
      "description": "A node, and every node beneath it, without animation tracks; what schemaVersions 1 to 3 allow.",
      "properties": {
        "tracks": false,
        "children": { "type": "array", "items": { "$ref": "#/$defs/nodeWithoutTracks" } }
      }
    },
    "nodeWithoutMaterial": {
      "description": "A node, and every node beneath it, without a material reference.",
      "properties": {
        "material": false,
        "children": { "type": "array", "items": { "$ref": "#/$defs/nodeWithoutMaterial" } }
      }
    },
    "materialReference": {
      "description": "A registered material named by id with values for its uniforms. The uniforms' types, ranges and defaults belong to the material's registration, not to the document.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "values"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
        "values": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/materialValue" }
        }
      }
    },
    "materialValue": {
      "oneOf": [
        { "type": "number" },
        { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["red", "green", "blue", "alpha"],
          "properties": {
            "red": { "type": "number" },
            "green": { "type": "number" },
            "blue": { "type": "number" },
            "alpha": { "type": "number" }
          }
        }
      ]
    },
    "nodeWithoutCompositing": {
      "description": "A node, and every node beneath it, without a compositing object.",
      "not": { "required": ["compositing"] },
      "properties": {
        "children": { "type": "array", "items": { "$ref": "#/$defs/nodeWithoutCompositing" } }
      }
    },
    "animationTrack": {
      "description": "A keyframed animation of one property of its node, evaluated at the host clock the caller passes. Keyframe times are seconds and strictly increase. Colour properties take #rrggbb or #rrggbbaa values; the others take numbers. index addresses a shadow, gradient or text run and stop a gradient stop; other properties take neither. A spring segment lasts at least the spring's settle time, which the validator checks.",
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "keyframes"],
      "allOf": [
        {
          "if": { "properties": { "property": { "enum": ["fill", "strokeColor", "shadowColor", "gradientStopColor", "textRunColor"] } } },
          "then": { "properties": { "keyframes": { "items": { "properties": { "value": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" } } } } } },
          "else": { "properties": { "keyframes": { "items": { "properties": { "value": { "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38 } } } } } }
        },
        {
          "if": { "properties": { "property": { "enum": ["shadowColor", "gradientStopColor", "textRunColor"] } } },
          "else": { "not": { "required": ["index"] } }
        },
        {
          "if": { "properties": { "property": { "const": "gradientStopColor" } } },
          "else": { "not": { "required": ["stop"] } }
        }
      ],
      "properties": {
        "property": {
          "enum": ["opacity", "translateX", "translateY", "scaleX", "scaleY", "rotation", "fill", "strokeColor", "shadowColor", "gradientStopColor", "textRunColor"]
        },
        "index": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "stop": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "keyframes": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/keyframe" } }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "value"],
      "properties": {
        "time": { "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38 },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" }
          ]
        },
        "easing": { "$ref": "#/$defs/easing" }
      }
    },
    "easing": {
      "oneOf": [
        { "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out"] },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "x1", "y1", "x2", "y2"],
          "properties": {
            "type": { "const": "cubicBezier" },
            "x1": { "type": "number", "minimum": 0, "maximum": 1 },
            "y1": { "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38 },
            "x2": { "type": "number", "minimum": 0, "maximum": 1 },
            "y2": { "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "steps"],
          "if": { "properties": { "position": { "const": "none" } }, "required": ["position"] },
          "then": { "properties": { "steps": { "minimum": 2 } } },
          "properties": {
            "type": { "const": "steps" },
            "steps": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "position": { "enum": ["start", "end", "none", "both"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "spring" },
            "stiffness": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.4028234663852886e38 },
            "damping": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.4028234663852886e38 },
            "mass": { "type": "number", "exclusiveMinimum": 0, "maximum": 3.4028234663852886e38 },
            "velocity": { "type": "number", "minimum": -3.4028234663852886e38, "maximum": 3.4028234663852886e38 }
          }
        }
      ]
    },
    "blendMode": {
      "enum": [
        "normal", "multiply", "screen", "overlay", "darken", "lighten", "difference", "exclusion",
        "source_over", "destination_in", "destination_out",
        "hue", "saturation", "color", "luminosity", "color_dodge", "color_burn", "hard_light",
        "soft_light", "clear", "source", "destination", "source_in", "source_out", "source_atop",
        "destination_over", "destination_atop", "xor", "plus"
      ],
      "description": "The first eleven are Tier 1, required of every backend. The rest are Tier 2, required of Skia Graphite and optional elsewhere, where an unsupported mode is drawn as normal with a loss diagnostic."
    },
    "compositing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mirrors the renderer's scene node. Only values that differ from their defaults are emitted. maskRef names a sibling node whose compositing.mask is set; the root has neither mask nor maskRef.",
      "properties": {
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blendMode": { "$ref": "#/$defs/blendMode" },
        "isolate": { "type": "boolean" },
        "mask": { "enum": ["alpha", "luminance"] },
        "maskRef": { "type": "string", "minLength": 1 }
      },
      "if": { "required": ["mask"] },
      "then": {
        "description": "A mask is coverage, not paint, so a mask node takes no blend mode but normal.",
        "properties": { "blendMode": { "const": "normal" } }
      }
    },
    "nodeWithoutPlot": {
      "description": "A node, and every node beneath it, without a plot binding; what schemaVersion 1 to 4 allows.",
      "properties": {
        "plot": false,
        "children": { "type": "array", "items": { "$ref": "#/$defs/nodeWithoutPlot" } }
      }
    },
    "plotBinding": {
      "description": "A plot of a value-feed channel. The document names the channel and how to draw it; samples arrive at run time, so the document carries none.",
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "channel"],
      "if": { "properties": { "style": { "const": "meter" } } },
      "else": { "required": ["slots"] },
      "allOf": [
        {
          "if": { "required": ["style"], "properties": { "style": { "enum": ["line", "area"] } } },
          "then": { "properties": { "source": { "enum": ["scalar", "vector"] } } }
        },
        {
          "if": { "required": ["style"], "properties": { "style": { "const": "bar" } } },
          "then": { "properties": { "source": { "const": "vector" } } }
        },
        {
          "if": { "required": ["style"], "properties": { "style": { "const": "meter" } } },
          "then": { "properties": { "source": { "const": "meter" } } }
        }
      ],
      "properties": {
        "style": { "enum": ["line", "area", "bar", "meter"] },
        "channel": { "type": "string", "minLength": 1 },
        "source": { "enum": ["scalar", "meter", "vector"] },
        "slots": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "history": { "enum": ["scroll", "sweep"] },
        "orientation": { "enum": ["vertical", "horizontal"] },
        "audioChannel": { "type": "integer", "minimum": 0, "maximum": 1024 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "baseline": { "type": "number" },
        "lineWidth": { "type": "number", "minimum": 0, "maximum": 4096.000244140625 },
        "barGap": { "type": "number", "minimum": 0, "maximum": 4096.000244140625 },
        "peakWidth": { "type": "number", "minimum": 0, "maximum": 4096.000244140625 },
        "lineColor": { "$ref": "#/$defs/plotColor" },
        "fillColor": { "$ref": "#/$defs/plotColor" },
        "peakColor": { "$ref": "#/$defs/plotColor" }
      }
    },
    "plotColor": { "type": "string", "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$type", "$value", "sourcePath"],
      "properties": {
        "$type": { "type": "string", "minLength": 1 },
        "$value": { "$ref": "#/$defs/jsonValue" },
        "$description": { "type": "string" },
        "sourcePath": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string" },
        "mimeType": { "type": "string" },
        "uri": { "type": "string" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "provenance": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "disposition", "message", "path", "severity"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["portable", "lowered", "rasterized", "web-only", "extension", "unsupported"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "property": { "type": "string" },
        "remediation": { "$ref": "#/$defs/jsonValue" },
        "sourceLocation": { "$ref": "#/$defs/jsonValue" },
        "detail": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "lossReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byDisposition", "bySeverity", "lossCount", "losses", "totalDiagnostics"],
      "properties": {
        "byDisposition": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "bySeverity": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "lossCount": { "type": "integer", "minimum": 0 },
        "losses": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "totalDiagnostics": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
