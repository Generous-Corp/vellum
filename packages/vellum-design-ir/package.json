{
  "name": "@vellum/design-ir",
  "version": "0.1.0-experimental.0",
  "description": "Canonical, deterministic DesignIR and safe overlay-aware reimport primitives for Vellum",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
