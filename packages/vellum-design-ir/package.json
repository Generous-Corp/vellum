    "./schema/authored-overlay-v1": "./schema/authored-overlay-v1.schema.json",
    "./schema/reimport-report-v1": "./schema/reimport-report-v1.schema.json"
  },
  "bin": {
    "vellum-import-backend": "./bin/vellum-backend.js",
    "vellum-design-ir": "./bin/vellum-design-ir.js"
