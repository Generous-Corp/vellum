# Build a plugin-shaped consumer against every generated rehearsal target, then
# census the resulting rehearsal archives for duplicate Pulp symbols/providers.
set(_prefix "${CMAKE_CURRENT_BINARY_DIR}/mirror-plugin-consumer-prefix")
file(REMOVE_RECURSE "${_prefix}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${VELLUM_BUILD_DIR}" --prefix "${_prefix}" --config "${TEST_CONFIG}" RESULT_VARIABLE _install)
if(NOT _install EQUAL 0)
  message(FATAL_ERROR "mirror plugin install failed: ${_install}")
endif()
include("${VELLUM_GENERATED_UNITS}")
set(_src "${CMAKE_CURRENT_BINARY_DIR}/mirror-plugin-consumer-src")
file(MAKE_DIRECTORY "${_src}")
file(WRITE "${_src}/main.cpp" "int main() { return 0; }\n")
file(WRITE "${_src}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(MirrorPluginConsumer LANGUAGES CXX)\nfind_package(Vellum CONFIG REQUIRED)\nadd_executable(plugin main.cpp)\n")
set(_links "")
foreach(_entry IN LISTS VELLUM_MIRROR_REHEARSAL_TARGETS)
  string(REPLACE "|" ";" _parts "${_entry}")
  list(GET _parts 0 _unit)
  list(GET _parts 1 _target)
  string(APPEND _links "target_link_libraries(plugin PRIVATE Vellum::MirrorRehearsal_${_unit}_${_target})\n")
endforeach()
file(APPEND "${_src}/CMakeLists.txt" "${_links}")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_src}" -B "${CMAKE_CURRENT_BINARY_DIR}/mirror-plugin-consumer-build" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=${_prefix} RESULT_VARIABLE _cfg)
if(NOT _cfg EQUAL 0)
  message(FATAL_ERROR "plugin-shaped consumer configure failed: ${_cfg}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_CURRENT_BINARY_DIR}/mirror-plugin-consumer-build" RESULT_VARIABLE _build)
if(NOT _build EQUAL 0)
  message(FATAL_ERROR "plugin-shaped consumer build failed: ${_build}")
endif()
file(GLOB_RECURSE _archives "${VELLUM_BUILD_DIR}/libvellum-mirror-rehearsal-*.a")
if(NOT _archives)
  message(FATAL_ERROR "no rehearsal archives found for ODR/provider census")
endif()
execute_process(COMMAND "${VELLUM_SOURCE_DIR}/tools/packaging/mirror_plugin_census.py" ${_archives} RESULT_VARIABLE _census)
if(NOT _census EQUAL 0)
  message(FATAL_ERROR "plugin ODR/provider census failed: ${_census}")
endif()
