set(_prefix "${CMAKE_CURRENT_BINARY_DIR}/mirror-consumer-prefix")
file(REMOVE_RECURSE "${_prefix}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${VELLUM_BUILD_DIR}" --prefix "${_prefix}" --config "${TEST_CONFIG}" RESULT_VARIABLE _install)
if(NOT _install EQUAL 0)
  message(FATAL_ERROR "mirror package install failed: ${_install}")
endif()
set(_src "${CMAKE_CURRENT_BINARY_DIR}/mirror-consumer-src")
file(MAKE_DIRECTORY "${_src}")
file(COPY "${VELLUM_SOURCE_DIR}/tests/mirror_consumer.cpp" DESTINATION "${_src}")
file(WRITE "${_src}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(MirrorConsumer LANGUAGES CXX)\nfind_package(Vellum CONFIG REQUIRED)\nadd_executable(mirror-consumer mirror_consumer.cpp)\ntarget_link_libraries(mirror-consumer PRIVATE Vellum::MirrorCanvas)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_src}" -B "${CMAKE_CURRENT_BINARY_DIR}/mirror-consumer-build" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=${_prefix} RESULT_VARIABLE _cfg)
if(NOT _cfg EQUAL 0)
  message(FATAL_ERROR "sterile consumer configure failed: ${_cfg}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${CMAKE_CURRENT_BINARY_DIR}/mirror-consumer-build" RESULT_VARIABLE _build)
if(NOT _build EQUAL 0)
  message(FATAL_ERROR "sterile consumer build failed: ${_build}")
endif()
execute_process(COMMAND "${CMAKE_CURRENT_BINARY_DIR}/mirror-consumer-build/mirror-consumer" RESULT_VARIABLE _run)
if(NOT _run EQUAL 0)
  message(FATAL_ERROR "sterile consumer execution failed: ${_run}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "ODR census: checking one archive owner per mirror target")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env PYTHONPATH="${VELLUM_SOURCE_DIR}" python3 "${VELLUM_SOURCE_DIR}/tools/packaging/mirror_odr_census.py" "${VELLUM_BUILD_DIR}/libvellum-mirror-foundation.a" "${VELLUM_BUILD_DIR}/libvellum-mirror-canvas.a" RESULT_VARIABLE _odr)
if(NOT _odr EQUAL 0)
  message(FATAL_ERROR "ODR census failed: ${_odr}")
endif()
message(STATUS "mirror sterile consumer + ODR census: PASS")
