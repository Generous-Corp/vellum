@PACKAGE_INIT@

# The installed binaries are built for one system and a fixed set of
# architectures (the GPU artifact is macOS arm64 only). A consumer that targets
# anything else (a universal or x86_64 macOS build, iOS, another OS) would
# otherwise import these targets and fail later at link time, or link one
# slice against libraries of the wrong architecture. Report the package as
# not found instead, so an optional consumer keeps its own fallback provider.
set(_vellum_package_system "@VELLUM_PACKAGE_SYSTEM_NAME@")
set(_vellum_package_architectures "@VELLUM_PACKAGE_ARCHITECTURES@")
if(APPLE AND CMAKE_OSX_ARCHITECTURES)
    set(_vellum_consumer_architectures "${CMAKE_OSX_ARCHITECTURES}")
else()
    set(_vellum_consumer_architectures "${CMAKE_SYSTEM_PROCESSOR}")
endif()
set(_vellum_unsupported "")
if(NOT CMAKE_SYSTEM_NAME STREQUAL _vellum_package_system)
    set(_vellum_unsupported
        "the consumer targets ${CMAKE_SYSTEM_NAME}; this package was built for ${_vellum_package_system}")
elseif(_vellum_consumer_architectures STREQUAL "")
    set(_vellum_unsupported "the consumer's target architecture is unknown")
else()
    foreach(_vellum_architecture IN LISTS _vellum_consumer_architectures)
        if(NOT _vellum_architecture IN_LIST _vellum_package_architectures)
            set(_vellum_unsupported
                "the consumer targets architecture(s) ${_vellum_consumer_architectures}; this package was built for ${_vellum_package_architectures}")
            break()
        endif()
    endforeach()
endif()
if(NOT _vellum_unsupported STREQUAL "")
    set(Vellum_FOUND FALSE)
    set(Vellum_NOT_FOUND_MESSAGE "Vellum: unsupported target platform: ${_vellum_unsupported}")
    unset(_vellum_package_system)
    unset(_vellum_package_architectures)
    unset(_vellum_consumer_architectures)
    unset(_vellum_architecture)
    unset(_vellum_unsupported)
    return()
endif()
unset(_vellum_package_system)
unset(_vellum_package_architectures)
unset(_vellum_consumer_architectures)
unset(_vellum_architecture)
unset(_vellum_unsupported)

include("${CMAKE_CURRENT_LIST_DIR}/VellumTargets.cmake")

check_required_components(Vellum)
