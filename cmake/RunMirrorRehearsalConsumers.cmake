# Configure one sterile external consumer per generated closure target.
set(_prefix "${CMAKE_CURRENT_BINARY_DIR}/mirror-rehearsal-consumer-prefix")
file(REMOVE_RECURSE "${_prefix}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${VELLUM_BUILD_DIR}" --prefix "${_prefix}" --config "${TEST_CONFIG}" RESULT_VARIABLE _install)
if(NOT _install EQUAL 0)
  message(FATAL_ERROR "mirror rehearsal install failed: ${_install}")
endif()
include("${VELLUM_GENERATED_UNITS}")
foreach(_entry IN LISTS VELLUM_MIRROR_REHEARSAL_TARGETS)
  string(REPLACE "|" ";" _parts "${_entry}")
  list(GET _parts 0 _unit)
  list(GET _parts 1 _target)
  set(_src "${CMAKE_CURRENT_BINARY_DIR}/mirror-rehearsal-${_unit}-${_target}-src")
  file(MAKE_DIRECTORY "${_src}")
  file(WRITE "${_src}/main.cpp" "int main() { return 0; }\n")
  file(WRITE "${_src}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(MirrorRehearsal LANGUAGES CXX)\nfind_package(Vellum CONFIG REQUIRED)\nadd_executable(rehearsal main.cpp)\ntarget_link_libraries(rehearsal PRIVATE Vellum::MirrorRehearsal_${_unit}_${_target})\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_src}" -B "${CMAKE_CURRENT_BINARY_DIR}/mirror-rehearsal-${_unit}-${_target}-build" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=${_prefix} RESULT_VARIABLE _cfg)
  if(NOT _cfg EQUAL 0)
    message(FATAL_ERROR "sterile rehearsal consumer configure failed for ${_unit}/${_target}: ${_cfg}")
  endif()
endforeach()
