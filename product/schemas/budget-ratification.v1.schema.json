{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vellum.invalid/schemas/budget-ratification.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "budgetSource", "requiredEvidence", "ratification"],
  "properties": {
    "schema": {"const": "vellum.budget-ratification.v1"},
    "status": {"enum": ["unratified", "ratified"]},
    "budgetSource": {"const": "product/budgets.yaml"},
    "requiredEvidence": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ratification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceCommit", "environment", "timings", "ratifiedValues"],
      "properties": {
        "evidenceCommit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "environment": {"type": ["string", "null"]},
        "timings": {"type": ["string", "null"]},
        "ratifiedValues": {"type": ["object", "null"]}
      }
    }
  }
}
