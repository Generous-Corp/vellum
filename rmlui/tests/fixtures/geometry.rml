<rml>
<head>
<title>Images, transforms and scissoring</title>
<style>
body {
    display: block;
    width: 256px;
    height: 200px;
    margin: 0;
    background-color: #1b1e24;
}
div { display: block; position: absolute; }
img { position: absolute; }
#image { left: 16px; top: 16px; width: 16px; height: 16px; }
/* Drawn at its natural size: the soft renderer samples nearest texels and the
   Metal renderer filters linearly, which agree only at 1:1. */
#rotated { left: 120px; top: 24px; width: 48px; height: 48px; background-color: #f2f2f2;
           transform: rotate(30deg); }
#scaled { left: 190px; top: 30px; width: 32px; height: 32px; background-color: rgba(255, 59, 48, 200);
          transform: scale(1.5) translate(4px, 2px); }
#clip { left: 16px; top: 110px; width: 120px; height: 60px; overflow: hidden;
        background-color: #3a4150; }
#clip div { position: static; margin-left: -20px; margin-top: -10px; width: 200px; height: 100px;
            background-color: rgba(154, 164, 184, 180); }
</style>
</head>
<body>
<img id="image" src="checker.png"/>
<div id="rotated"/>
<div id="scaled"/>
<div id="clip"><div/></div>
</body>
</rml>
