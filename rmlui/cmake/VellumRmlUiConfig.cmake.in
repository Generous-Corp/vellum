@PACKAGE_INIT@

# find_package(VellumRmlUi [COMPONENTS Core SoftRenderer DevAssets VellumRenderer Native])
#
# RmlUi and its font engine are linked privately into the VellumRmlUi::Core
# shared library, so this package needs no further dependency. Core is always
# provided; naming no components selects Core. VellumRenderer, when installed,
# is loaded only when asked for, and then needs the Vellum package.

set(_vellum_rmlui_supported_components @VELLUM_RMLUI_COMPONENTS@)
include("${CMAKE_CURRENT_LIST_DIR}/VellumRmlUiTargets.cmake")
if("VellumRenderer" IN_LIST VellumRmlUi_FIND_COMPONENTS AND
   EXISTS "${CMAKE_CURRENT_LIST_DIR}/VellumRmlUiVellumRendererTargets.cmake")
    include(CMakeFindDependencyMacro)
    find_dependency(Vellum CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/VellumRmlUiVellumRendererTargets.cmake")
endif()

# Native carries its own copy of RmlUi under RmlUi's target names.
if("Native" IN_LIST VellumRmlUi_FIND_COMPONENTS AND
   EXISTS "${CMAKE_CURRENT_LIST_DIR}/VellumRmlUiNativeTargets.cmake")
    if(NOT TARGET RmlUi::Core)
        include("${CMAKE_CURRENT_LIST_DIR}/VellumRmlUiRmlUiTargets.cmake")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/VellumRmlUiNativeTargets.cmake")
endif()

if(NOT VellumRmlUi_FIND_COMPONENTS)
    set(VellumRmlUi_FIND_COMPONENTS Core)
endif()
foreach(_vellum_rmlui_component IN LISTS VellumRmlUi_FIND_COMPONENTS)
    if(_vellum_rmlui_component IN_LIST _vellum_rmlui_supported_components AND
       TARGET VellumRmlUi::${_vellum_rmlui_component})
        set(VellumRmlUi_${_vellum_rmlui_component}_FOUND TRUE)
    else()
        set(VellumRmlUi_${_vellum_rmlui_component}_FOUND FALSE)
    endif()
endforeach()
unset(_vellum_rmlui_component)
unset(_vellum_rmlui_supported_components)

set(VellumRmlUi_FONTS_ENABLED @VELLUM_RMLUI_FONTS@)

# The macOS deployment target the libraries were built with (empty elsewhere).
# A consumer targeting older macOS would link objects that need newer macOS.
set(VellumRmlUi_OSX_DEPLOYMENT_TARGET "@CMAKE_OSX_DEPLOYMENT_TARGET@")
if(APPLE AND VellumRmlUi_OSX_DEPLOYMENT_TARGET AND CMAKE_OSX_DEPLOYMENT_TARGET AND
   CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS VellumRmlUi_OSX_DEPLOYMENT_TARGET)
    message(WARNING
        "VellumRmlUi was built for macOS ${VellumRmlUi_OSX_DEPLOYMENT_TARGET}, newer than this "
        "project's deployment target ${CMAKE_OSX_DEPLOYMENT_TARGET}")
endif()

check_required_components(VellumRmlUi)
