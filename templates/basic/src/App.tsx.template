import { HomeScreen } from "../ui/generated/Home.generated";
import { Design, useState } from "@vellum/ui";
import { importedBindings, importedDesign } from "@vellum/imported";

export function App() {
  const [count, setCount] = useState(0);
  if (importedDesign) {
    return (
      <Design
        document={importedDesign}
        bindings={importedBindings}
        actions={{}}
      />
    );
  }
  return (
    <HomeScreen
      title={"{{PROJECT_NAME_JSON}}"}
      count={count}
      onIncrement={() => setCount((value) => value + 1)}
    />
  );
}
