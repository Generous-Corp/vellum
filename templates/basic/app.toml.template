[app]
name = "{{PROJECT_NAME_JSON}}"
identifier = "dev.vellum.{{PROJECT_SLUG}}"
version = "0.1.0"
entry = "src/main.tsx"
design = "design/ir/app.designir.json"

[runtime]
profile = "portable"
native_js_engine = "default"

[targets]
desktop = ["macos"]
mobile = []
web = true

[capabilities]
commands = "denied"
files = "denied"
clipboard = "denied"
open_url = "denied"
network = false
# Opt in with "state-v1" for bounded whole-app snapshots on the native host.
persistence = "denied"

[native]
components_manifest = "native/components.toml"

[packaging]
macos_format = "app"
web_format = "static"

[packaging.overrides]
