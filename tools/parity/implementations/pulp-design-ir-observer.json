{
  "schema": "vellum.parity.implementation.v1",
  "name": "pulp-design-ir-observer",
  "repository": "Generous-Corp/pulp",
  "source_sha": null,
  "description": "Pulp's registered pulp-import-design (baked ir-json emit) and pulp-design-ir-observe (Skia CPU render, laid-out tree, text diagnostics, pointer/keyboard replay). Tool paths and roots (checkout = the git checkout the tools were built from; build = its CMake build directory) are supplied per run; the commit is read from the checkout and every binary is content-hashed.",
  "tools": {
    "importer": "build/tools/import-design/pulp-import-design",
    "observer": "build/tools/import-design/pulp-design-ir-observe"
  },
  "source_kinds": {
    "figma-plugin": [
      "--from",
      "figma-plugin"
    ],
    "html-offline": [
      "--offline"
    ],
    "design-ir": []
  },
  "interaction_encoding": "argv-click-drag-key",
  "steps": [
    {
      "id": "import",
      "source_kinds": [
        "figma-plugin",
        "html-offline"
      ],
      "argv": [
        "{tool:importer}",
        "@source_kind_args",
        "--file",
        "{source}",
        "--emit",
        "ir-json",
        "--mode",
        "baked",
        "--output",
        "design.ir.json",
        "--no-tokens"
      ]
    },
    {
      "id": "import",
      "source_kinds": [
        "design-ir"
      ],
      "argv": [
        "/bin/cp",
        "{source}",
        "design.ir.json"
      ]
    },
    {
      "id": "observe",
      "argv": [
        "{tool:observer}",
        "--input",
        "design.ir.json",
        "--render",
        "render.png",
        "--layout",
        "layout.json",
        "--text-diagnostics",
        "text.json",
        "--width",
        "{width}",
        "--height",
        "{height}",
        "--scale",
        "{scale}"
      ]
    },
    {
      "id": "interact",
      "when": "interactions",
      "argv": [
        "{tool:observer}",
        "--input",
        "design.ir.json",
        "--render",
        "interaction.png",
        "--layout",
        "interaction-layout.json",
        "--width",
        "{width}",
        "--height",
        "{height}",
        "--scale",
        "{scale}",
        "--interaction-log",
        "interaction.json",
        "@interactions"
      ]
    }
  ],
  "roots": {
    "checkout": "git checkout the tools were built from",
    "build": "CMake build directory of those tools"
  },
  "probes": [
    {
      "name": "build",
      "argv": [
        "/bin/sh",
        "-c",
        "grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER|CMAKE_OSX_ARCHITECTURES|PULP_ENABLE_GPU|PULP_HAS_SKIA)[:=]' '{root:build}/CMakeCache.txt' && \"$(grep -E '^CMAKE_CXX_COMPILER:' '{root:build}/CMakeCache.txt' | cut -d= -f2)\" --version | head -1"
      ]
    },
    {
      "name": "provider",
      "argv": [
        "/bin/sh",
        "-c",
        "grep -E '^PULP_SKIA_ICUDTL_FILE' '{root:build}/CMakeCache.txt'; grep -m2 -E 'Release|Commit' '{root:checkout}/external/skia-build/VERSION.md'; echo 'renderer: pulp::view::render_to_file ScreenshotBackend::skia (CPU raster)'; otool -L '{tool:observer}' | tail -n +2 | sed 's/ (.*//'"
      ]
    },
    {
      "name": "fonts",
      "argv": [
        "/bin/sh",
        "-c",
        "cd '{root:checkout}/external/fonts' && shasum -a 256 *.ttf"
      ]
    }
  ],
  "authority": "native-render",
  "passthrough_binaries": [
    {
      "path": "/bin/cp",
      "justification": "The design-ir source kind copies the input DesignIR; its structure lane then compares inputs, not an import."
    }
  ]
}
