{
  "schema": "vellum.parity.host-corpus.v1",
  "corpus_id": "pulp-gpu-editor-host-v1",
  "description": "Two Pulp example plug-ins whose editors require the GPU host (SpectralLab, SuperConvolver), in every format this host can load without installing anything, alone and side by side in one process; pluginval over both VST3 bundles; both standalone apps.",
  "cases": [
